# Copy to keystore.properties and fill in (never commit keystore.properties).
# Generate keystore:
#   keytool -genkeypair -v -storetype PKCS12 -keystore milestone-life-release.keystore -alias milestone-life -keyalg RSA -keysize 2048 -validity 10000

storeFile=milestone-life-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=milestone-life
keyPassword=YOUR_KEY_PASSWORD
