# Neon database connection string (required)
# Get from https://console.neon.tech → your project → Connection Details (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# NextAuth secret (required) — generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# Google OAuth (optional) — enables Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini API key (optional) — enables the AI goal wizard and chat assistant.
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional model override for the agent (defaults to gemini-2.5-flash):
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic API key (optional) — enables milestone suggestions in the manual goal form.
ANTHROPIC_API_KEY=
# Optional model overrides:
# ANTHROPIC_SUGGEST_MODEL=claude-haiku-4-5-20251001

# Resend (optional) — invite and password-reset email (see lib/email.ts)
RESEND_API_KEY=
# Must be a verified sender domain in Resend:
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Stripe (optional) — Pro billing (see lib/stripe.ts, app/pricing)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Canonical public URL (optional) — used for metadata/links.
# On Vercel, VERCEL_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
